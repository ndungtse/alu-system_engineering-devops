#!/usr/bin/env bash
# Installs HAProxy on lb-01 and load balances web-01 and web-02 with roundrobin
apt-get update -y
apt-get install -y haproxy
if ! grep -q "^ENABLED=1" /etc/default/haproxy; then
	echo "ENABLED=1" >> /etc/default/haproxy
fi
if ! grep -q "backend web_servers" /etc/haproxy/haproxy.cfg; then
	sed -i '/^global/a \\th1-case-adjust x-served-by X-Served-By' /etc/haproxy/haproxy.cfg
	cat >> /etc/haproxy/haproxy.cfg <<CONFIG

frontend http_front
	bind *:80
	mode http
	option h1-case-adjust-bogus-client
	default_backend web_servers

backend web_servers
	balance roundrobin
	server 7258-web-01 35.178.210.214:80 check
	server 7258-web-02 18.175.116.119:80 check
CONFIG
fi
service haproxy restart
