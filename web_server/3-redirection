#!/usr/bin/env bash
# Installs nginx and configures /redirect_me as a 301 Moved Permanently redirection
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
if ! grep -q "location /redirect_me" /etc/nginx/sites-available/default; then
	sed -i '0,/^\s*server_name/{/^\s*server_name/a \\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}
}' /etc/nginx/sites-available/default
fi
service nginx restart
